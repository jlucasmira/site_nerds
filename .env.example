# Public base URL
NEXT_PUBLIC_SITE_URL=https://nerds-portal.vercel.app

# Optional: enable bundle analyzer
ANALYZE=false

# Vercel deployment secrets (GitHub Actions)
VERCEL_TOKEN=replace_with_vercel_token
VERCEL_ORG_ID=replace_with_vercel_org_id
VERCEL_PROJECT_ID=replace_with_vercel_project_id

# GitHub PAT (if using HTTPS push without credential manager)
GITHUB_PAT=replace_with_personal_access_token
